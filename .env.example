# ─── PocketBase 连接（Web 模式必需）───
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@admin.com
PB_ADMIN_PASSWORD=adminadmin123

# ─── MinerU OCR API（仅扫描件/混合型 PDF 需要）───
# 免费 Agent API 无需 Token（限制：≤10MB、≤20 页）；
# 申请地址：https://mineru.net/apiManage
# MINERU_API_TOKEN=

# ─── Flask 服务 ───
FLASK_PORT=5000
FLASK_DEBUG=0

# ─── MinerU OCR 并发与轮询 ───
MAX_CONCURRENT_TASKS=3
POLL_INTERVAL=5
TASK_TIMEOUT=600
